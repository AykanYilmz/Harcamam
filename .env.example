# Copy to .env and adjust. Never commit the real .env file.
# docker-compose reads this file automatically; every value has a local default.

# --- PostgreSQL ---
POSTGRES_USER=harcamam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=harcamam

# --- Backend ---
# Used when running the backend outside Docker (host machine -> localhost).
DATABASE_URL=postgresql+psycopg://harcamam:change-me@localhost:5432/harcamam
# JSON list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend ---
VITE_API_URL=http://localhost:8000
