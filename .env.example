# Copy to .env and adjust. Never commit the real .env file.
# docker-compose reads this file automatically; the values below match its local defaults.

# --- PostgreSQL ---
POSTGRES_USER=hesapkitap
POSTGRES_PASSWORD=hesapkitap
POSTGRES_DB=hesapkitap

# --- Backend ---
# Used when running the backend outside Docker (host machine -> localhost).
DATABASE_URL=postgresql+psycopg://hesapkitap:hesapkitap@localhost:5432/hesapkitap
# JSON list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173"]
# Required. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Email ---
# Development uses the Mailpit container (inbox: http://localhost:8025).
# In production, point these at a real SMTP provider.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=HesapKitap <no-reply@hesapkitap.local>

# --- Frontend ---
VITE_API_URL=http://localhost:8000
