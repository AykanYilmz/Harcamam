# Settings for docker-compose.prod.yml. Copy to .env.production and fill in every value.
# Never commit the filled-in file (.gitignore already excludes .env.*).

# --- PostgreSQL ---
POSTGRES_USER=hesapkitap
# Long and random: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=hesapkitap

# --- Backend ---
# Signs the login tokens. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# The public address of the site, used in email links. Must be https:// (localhost excepted).
FRONTEND_URL=https://hesapkitap.example.com

# --- Email (verification links) ---
# Any SMTP provider, e.g. Brevo, Mailgun, Amazon SES. Without one the app still works,
# but verification emails are not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=HesapKitap <no-reply@hesapkitap.example.com>

# --- Web ---
# Port the site is published on.
WEB_PORT=80
